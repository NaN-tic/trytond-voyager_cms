<form>
    <label name="title"/>
    <field name="title"/>
    <group id="checkboxes" colspan="2">
        <label name="active"/>
        <field name="active"/>
    </group>
    <label name="site"/>
    <field name="site"/>
    <label name="category"/>
    <field name="category"/>
    <label name="image"/>
    <field name="image"/>
    <label name="state"/>
    <field name="state"/>
    <label name="published_date"/>
    <field name="published_date"/>
    <group col="-1" colspan="4" id="buttons">
        <button name="draft"/>
        <button name="publish"/>
    </group>
    <notebook colspan="4">
        <page string="Text" id="text">
            <field name="text" colspan="4"/>
        </page>
        <page string="Uris" id="uris">
            <field name="uris" colspan="4" mode="tree,form" height="250"/>
            <button name="generate_uri" colspan="4"/>
        </page>
        <page string="Comments" id="comments">
            <field name="comments" colspan="4" mode="tree,form" height="300"/>
        </page>
        <page string="SEO" id="seo">
            <label name="seo_title"/>
            <field name="seo_title" colspan="3"/>
            <label name="seo_keywords"/>
            <field name="seo_keywords" colspan="3"/>
            <label name="seo_description"/>
            <field name="seo_description" colspan="3"/>
            <separator string="Open Graph" colspan="4" id="seo_open_graph"/>
            <label name="seo_og_title"/>
            <field name="seo_og_title" colspan="3"/>
            <label name="seo_og_image_file"/>
            <field name="seo_og_image_file" colspan="3"/>
            <label name="seo_og_description"/>
            <field name="seo_og_description" colspan="3"/>
        </page>
    </notebook>
</form>
