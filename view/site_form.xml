<?xml version="1.0"?>
<data>
    <xpath expr="/form/field[@name='title']" position="after">
        <separator string="CMS" colspan="4" id="cms"/>
        <label name="layout"/>
        <field name="layout"/>
        <label name="header"/>
        <field name="header"/>
        <label name="footer"/>
        <field name="footer"/>
        <label name="main_language"/>
        <field name="main_language"/>
        <separator string="SEO Title Composition" colspan="4" id="seo_title_composition"/>
        <label name="seo_title_prefix"/>
        <field name="seo_title_prefix" colspan="3"/>
        <label name="seo_title_separator"/>
        <field name="seo_title_separator" colspan="3"/>
        <label name="seo_title_suffix"/>
        <field name="seo_title_suffix" colspan="3"/>
        <field name="languages" colspan="4" mode="tree,form" height="200"/>
        <newline/>
    </xpath>
</data>
